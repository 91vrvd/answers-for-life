.count-page { display:flex; flex-direction:column; }
.title { margin:28rpx 0 26rpx; font-size:66rpx; line-height:1.3; font-weight:600; }
.description { color:#77716B; font-size:25rpx; line-height:1.8; }
.options { margin-top:55rpx; display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.option { position:relative; min-height:150rpx; border:1rpx solid #E8E3DE; border-radius:30rpx; display:flex; align-items:center; justify-content:center; gap:8rpx; color:#77716B; }
.option.selected { border-color:#B86F72; background:#F0DEDC; color:#9F5E61; }
.option .serif { font-size:52rpx; color:#242220; }
.recommend { position:absolute; right:14rpx; top:12rpx; padding:3rpx 10rpx; border-radius:999rpx; background:#B86F72; color:#fff; font-size:14rpx; }
.summary { margin-top:38rpx; padding:28rpx 0; display:grid; grid-template-columns:150rpx 1fr; gap:20rpx; border-top:1rpx solid #E8E3DE; border-bottom:1rpx solid #E8E3DE; font-size:21rpx; }
.summary text:nth-child(odd) { color:#77716B; }.summary text:nth-child(even) { text-align:right; font-weight:600; }
.bottom { margin-top:auto; text-align:center; }.bottom>text { display:block; margin-top:22rpx; color:#A49E97; font-size:19rpx; }
