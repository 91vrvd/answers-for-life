.hero { margin:28rpx 0 18rpx; font-size:60rpx; line-height:1.45; font-weight:600; white-space:pre-line; }.hero text { color:#B86F72; font-size:86rpx; font-weight:500; }
.theme-name { font-size:25rpx; }.result-note { margin-top:16rpx; color:#77716B; font-size:21rpx; line-height:1.7; }
.section-title { margin-top:55rpx; padding-bottom:22rpx; display:flex; justify-content:space-between; border-bottom:1rpx solid #E8E3DE; }.section-title text:first-child { font-size:28rpx; font-weight:600; }.section-title text:last-child { color:#AAA39D; font-size:16rpx; letter-spacing:2rpx; }
.answer-row { padding:34rpx 0; display:grid; grid-template-columns:48rpx 1fr; gap:16rpx; border-bottom:1rpx solid #E8E3DE; }.answer-number { color:#AAA39D; font-family:"Songti SC",serif; font-size:20rpx; }.category { color:#B86F72; font-size:16rpx; }.question { margin:12rpx 0 19rpx; font-size:29rpx; line-height:1.55; font-weight:600; }.answer { padding-left:20rpx; border-left:4rpx solid #809783; color:#4F4A46; font-size:23rpx; line-height:1.8; white-space:pre-wrap; }.answer.empty { border-color:#E8E3DE; color:#A29B95; }
.export-panel { margin-top:52rpx; padding:42rpx 34rpx; border:1rpx solid #DED8D2; border-radius:40rpx; background:#F2EEE9; }.export-panel>view { margin:18rpx 0; font-size:44rpx; font-weight:600; }.export-panel>text:nth-child(3) { display:block; margin-bottom:30rpx; color:#77716B; font-size:21rpx; }.export-panel .secondary { margin-top:16rpx; background:rgba(255,254,252,.55); }
.preview-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }.preview-grid>view { overflow:hidden; border:1rpx solid #E8E3DE; border-radius:24rpx; background:#FFFEFC; }.preview-grid image { width:100%; display:block; }.preview-grid button { min-height:70rpx; background:transparent; color:#77716B; font-size:19rpx; }
.another { margin-top:45rpx; background:transparent; color:#77716B; font-size:22rpx; }.hidden-canvas { position:fixed; left:-3000px; top:-3000px; width:1080px; height:1440px; }
